# Copia este archivo a .env y completa tus credenciales
# cp .env.example .env
# NUNCA comitees .env (ya está en .gitignore)

# MongoDB
MongoDbSettings__ConnectionString=mongodb+srv://<db_username>:<db_password>@cluster0.u9vl569.mongodb.net/?appName=Cluster0
MongoDbSettings__DatabaseName=ElReyDelTrenFantasma

# Usuarios: viven solo en la colección `users` de MongoDB (ver README_BACK.md).
# No hay seed ni fallback de admin: si la colección está vacía, nadie puede entrar
# hasta dar de alta el primer usuario directamente en la base de datos.

# CORS - front desacoplado (GitHub Pages)
Cors__AllowedOrigins__0=http://localhost:5500
Cors__AllowedOrigins__1=http://127.0.0.1:5500
Cors__AllowedOrigins__2=https://dieguino3893.github.io
Cors__AllowedOrigins__3=https://elrey-del-trenfantasma.vellumdigitall.online

# Cloudinary - drag & drop
Cloudinary__CloudName=<tu_cloud_name>
Cloudinary__ApiKey=<tu_api_key>
Cloudinary__ApiSecret=<tu_api_secret>

# Spotify / YouTube (manual por ahora, ver docs/music-sync-guide.md)
Spotify__ClientId=
Spotify__ClientSecret=
YouTube__ApiKey=

# Asistente del panel (/admin/asistente). Sin key el chat muestra aviso y no responde.
# Misma key que el taller pespunte (Asistente:ApiKey). Nunca en el repo.
Asistente__ApiKey=

# URL pública del front (la usa el Admin para el botón "Ver tu sitio").
# En GitHub es el secret FRONTEND_URL.
Frontend__PublicUrl=