@* Modal reutilizable: seleccionar de nube (Media) o subir nuevo con nombre. Uso: <button onclick="openImagePicker('imgUrl')">Elegir</button> + input id="imgUrl" *@
<style>
.imgpick-overlay{ position:fixed; inset:0; background:rgba(6,7,10,.78); backdrop-filter:blur(8px); display:none; place-items:center; z-index:9999; padding:20px; }
.imgpick-overlay.open{ display:grid; }
.imgpick{ width:100%; max-width:860px; max-height:90vh; overflow:auto; background:var(--surf, #0E1116); border:1px solid var(--line, rgba(255,255,255,.08)); border-radius:18px; padding:18px; }
.imgpick h3{ font-family:'Space Grotesk',sans-serif; }
.tabs{ display:flex; gap:8px; margin:12px 0; }
.tab{ padding:8px 14px; border-radius:999px; border:1px solid var(--line); background:transparent; color:var(--muted); cursor:pointer; font-family:'JetBrains Mono',monospace; font-size:.7rem; }
.tab.active{ background:var(--text, #F5F0E6); color:var(--bg, #06070A); border-color:var(--text); }
.grid{ display:grid; grid-template-columns: repeat(auto-fill,minmax(140px,1fr)); gap:10px; margin-top:12px; }
.card-img{ border:1px solid var(--line); border-radius:12px; overflow:hidden; background:var(--surf2, #12151C); cursor:pointer; transition:.15s; }
.card-img:hover{ border-color:var(--accent, #FF4E2A); transform:translateY(-2px); }
.card-img img{ width:100%; aspect-ratio:1; object-fit:cover; display:block; }
.card-img.selected{ outline:2px solid var(--accent); border-color:var(--accent); }
.mono{ font-family:'JetBrains Mono',monospace; font-size:.68rem; color:var(--muted); }
.drop{ border:1px dashed var(--line); border-radius:12px; padding:18px; text-align:center; cursor:pointer; background:rgba(255,255,255,.02); transition:.15s; }
.drop.drag{ border-color:var(--accent); background:rgba(255,78,42,.08); }
</style>
<div id="imgPicker" class="imgpick-overlay" onclick="if(event.target===this) closeImagePicker()">
  <div class="imgpick">
    <div style="display:flex;justify-content:space-between;align-items:center">
      <h3><i class="fa-solid fa-images" style="color:var(--accent)"></i> Elige imagen</h3>
      <button onclick="closeImagePicker()" style="padding:6px 10px;border:1px solid var(--line);border-radius:999px;background:transparent;color:var(--muted);cursor:pointer">✕</button>
    </div>
    <div class="tabs">
      <button id="tabCloud" class="tab active" onclick="switchTab('cloud')"><i class="fa-solid fa-cloud"></i> De la nube</button>
      <button id="tabUpload" class="tab" onclick="switchTab('upload')"><i class="fa-solid fa-cloud-arrow-up"></i> Subir nueva</button>
    </div>
    <div id="paneCloud">
      <div style="display:flex;gap:8px;align-items:center;margin:8px 0">
        <input id="searchMedia" placeholder="Buscar por nombre..." style="flex:1;padding:8px 10px;border-radius:10px;border:1px solid var(--line);background:var(--surf2);color:var(--text)"/>
        <button onclick="loadMedia()" style="padding:8px 12px;border:1px solid var(--line);border-radius:999px;cursor:pointer"><i class="fa-solid fa-arrows-rotate"></i></button>
      </div>
      <div id="mediaGrid" class="grid"></div>
      <p id="mediaMsg" class="mono" style="margin-top:8px"></p>
    </div>
    <div id="paneUpload" style="display:none">
      <div class="field"><label class="mono">Nombre (para encontrarla después)</label><input id="upName" placeholder="Ej: Diego guitarra" style="width:100%;padding:10px;border:1px solid var(--line);border-radius:10px;background:var(--surf2);color:var(--text)"/></div>
      <div id="upDrop" class="drop" style="margin-top:10px"><i class="fa-solid fa-upload" style="font-size:22px;color:var(--accent)"></i><p style="margin-top:6px">Arrastra imagen aquí o haz clic</p><p class="mono">jpg/png/webp/gif — máx 10MB</p></div>
      <input id="upFile" type="file" accept="image/*" hidden/>
      <div style="margin-top:12px;display:flex;gap:8px">
        <button id="btnUpload" style="padding:10px 16px;background:var(--accent);color:#fff;border:none;border-radius:999px;cursor:pointer;font-weight:700">Subir</button>
        <span id="upMsg" class="mono" style="align-self:center"></span>
      </div>
    </div>
    <div style="margin-top:14px;display:flex;gap:8px;justify-content:flex-end">
      <button onclick="closeImagePicker()" style="padding:10px 16px;border:1px solid var(--line);border-radius:999px;background:transparent;cursor:pointer">Cancelar</button>
      <button id="btnSelect" disabled style="padding:10px 16px;background:var(--accent);color:#fff;border:none;border-radius:999px;cursor:pointer;opacity:.5">Seleccionar</button>
    </div>
  </div>
</div>
<script>
let _targetInputId = null;
let _selectedUrl = null;
let _selectedName = null;
let _mediaCache = [];

function openImagePicker(inputId){
  _targetInputId = inputId;
  _selectedUrl = null;
  document.getElementById('btnSelect').disabled = true;
  document.getElementById('btnSelect').style.opacity = '.5';
  document.getElementById('imgPicker').classList.add('open');
  switchTab('cloud');
  loadMedia();
}
function closeImagePicker(){ document.getElementById('imgPicker').classList.remove('open'); }
function switchTab(t){
  document.getElementById('paneCloud').style.display = t==='cloud' ? 'block' : 'none';
  document.getElementById('paneUpload').style.display = t==='upload' ? 'block' : 'none';
  document.getElementById('tabCloud').classList.toggle('active', t==='cloud');
  document.getElementById('tabUpload').classList.toggle('active', t==='upload');
}
async function loadMedia(){
  const grid = document.getElementById('mediaGrid');
  const msg = document.getElementById('mediaMsg');
  const q = document.getElementById('searchMedia').value.toLowerCase();
  grid.innerHTML = '<div class="mono">Cargando...</div>';
  try{
    let data = [];
    // intenta Media (con nombre), fallback a Cloudinary files
    try{ const r1 = await fetch('/api/v1/media', { credentials:'include' }); if(r1.ok) data = await r1.json(); } catch(e){}
    if(!data.length){
      const r2 = await fetch('/api/v1/files?prefix=elrey&max=100', { credentials:'include' });
      if(r2.ok){
        const files = await r2.json();
        data = files.map(f=>({ name: f.publicId.split('/').pop(), url: f.url, createdAt: f.createdAt, publicId: f.publicId }));
      }
    }
    _mediaCache = data;
    const filtered = q ? data.filter(m => (m.name||'').toLowerCase().includes(q)) : data;
    if(!filtered.length){ grid.innerHTML = '<div class="mono">No hay imágenes. Sube una nueva con nombre.</div>'; return; }
    grid.innerHTML = filtered.map(m => `
      <div class="card-img" data-url="${m.url}" data-name="${m.name}" onclick="selectCard(this)">
        <img src="${m.url}" alt="${m.name}" loading="lazy"/>
        <div style="padding:8px">
          <div style="font-size:.82rem;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${m.name}</div>
          <div class="mono" style="font-size:.62rem">${m.createdAt ? new Date(m.createdAt).toLocaleDateString() : ''}</div>
        </div>
      </div>
    `).join('');
    msg.textContent = filtered.length + ' imágenes disponibles';
  }catch(e){ grid.innerHTML = '<div style="color:#FB7185">Error: '+e.message+'</div>'; }
}
function selectCard(el){
  document.querySelectorAll('.card-img').forEach(c=>c.classList.remove('selected'));
  el.classList.add('selected');
  _selectedUrl = el.dataset.url;
  _selectedName = el.querySelector('div div')?.textContent || '';
  const btn = document.getElementById('btnSelect');
  btn.disabled = false; btn.style.opacity='1';
}
document.getElementById('btnSelect').addEventListener('click', ()=>{
  if(!_selectedUrl || !_targetInputId) return;
  const inp = document.getElementById(_targetInputId);
  if(inp){ inp.value = _selectedUrl; inp.dispatchEvent(new Event('input')); }
  closeImagePicker();
});
// upload con nombre
const upDrop = document.getElementById('upDrop');
const upFile = document.getElementById('upFile');
const upName = document.getElementById('upName');
const upMsg = document.getElementById('upMsg');
upDrop.addEventListener('click', ()=> upFile.click());
upDrop.addEventListener('dragover', e=>{ e.preventDefault(); upDrop.classList.add('drag'); });
upDrop.addEventListener('dragleave', ()=> upDrop.classList.remove('drag'));
upDrop.addEventListener('drop', e=>{ e.preventDefault(); upDrop.classList.remove('drag'); if(e.dataTransfer.files[0]){ upFile.files = e.dataTransfer.files; upName.value = upName.value || e.dataTransfer.files[0].name.replace(/\.[^/.]+$/,''); }});
upFile.addEventListener('change', ()=>{ if(upFile.files[0] && !upName.value) upName.value = upFile.files[0].name.replace(/\.[^/.]+$/,''); });
document.getElementById('btnUpload').addEventListener('click', async ()=>{
  const f = upFile.files[0];
  if(!f) return alert('Selecciona archivo');
  const name = upName.value.trim() || f.name.replace(/\.[^/.]+$/,'');
  upMsg.textContent = 'Subiendo...';
  const fd = new FormData(); fd.append('file', f); fd.append('name', name);
  try{
    const res = await fetch('/api/v1/media', { method:'POST', body: fd, credentials:'include' });
    const data = await res.json();
    if(!res.ok) throw new Error(data.detail||'Error');
    upMsg.textContent = 'Subido: ' + data.name;
    // seleccionar automáticamente
    _selectedUrl = data.url;
    const inp = document.getElementById(_targetInputId);
    if(inp) inp.value = data.url;
    loadMedia();
    switchTab('cloud');
  }catch(e){ upMsg.textContent = 'Error: '+e.message; }
});
document.getElementById('searchMedia').addEventListener('input', loadMedia);
</script>
