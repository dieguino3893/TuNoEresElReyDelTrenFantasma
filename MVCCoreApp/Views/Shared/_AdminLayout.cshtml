<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>@ViewData["Title"] · El Rey del Tren Fantasma</title>
<link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
<link rel="icon" type="image/png" sizes="32x32" href="~/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="~/favicon-16x16.png" />
<link rel="shortcut icon" href="~/favicon.ico" />
<link rel="apple-touch-icon" href="~/apple-touch-icon.png" />
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;1,9..144,400;1,9..144,600&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"/>
<link rel="stylesheet" href="/css/tokens.css?v=11"/>
<link rel="stylesheet" href="/css/admin.css?v=20"/>
<script>try{ if(localStorage.getItem('adminSideMini')==='1') document.documentElement.classList.add('admin-mini'); }catch(e){}</script>
</head>
<body>
@{
  var accion = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
  var modulo = accion switch {
    "Settings" or "Texts" or "Chips" or "ChipCreate" or "ChipEdit" => "contenido",
    "Sitio" or "SitioLienzo" => "sitio",
    "Members" or "MemberCreate" or "MemberEdit" => "miembros",
    "Shows" or "ShowCreate" or "ShowEdit" => "shows",
    "Setlists" or "SetlistCreate" or "SetlistEdit" or "SetlistPlay" => "setlists",
    "Rehearsals" or "RehearsalCreate" or "RehearsalEdit" => "ensayos",
    "News" or "NewsCreate" or "NewsEdit" => "noticias",
    "Tracks" or "TrackCreate" or "TrackEdit" => "musica",
    "Users" or "UserCreate" or "UserEdit" => "usuarios",
    "Asistente" => "asistente",
    "Files" => "archivos",
    _ => "panel"
  };
  Func<string, string> on = (m)=> modulo == m ? "active" : "";
}
<aside class="sidebar" id="sidebar">
  <div class="side-head">
    <a class="brand" href="/admin">El Rey <em>del Tren Fantasma</em></a>
    <button class="side-toggle" id="sideToggle" aria-label="Minimizar menú" aria-controls="sidebar" aria-expanded="true"><i class="fa-solid fa-bars"></i></button>
  </div>
  <nav class="nav" id="adminNav">
    <span class="nav-label">Sitio</span>
    <a href="/admin" class="@on("panel")" title="Panel"><i class="fa-solid fa-table-columns"></i><span>Panel</span></a>
    <a href="/admin/sitio" class="@on("sitio")" title="Sitio"><i class="fa-solid fa-pen-ruler"></i><span>Sitio</span></a>
    <a href="/admin/settings" class="@on("contenido")" title="Contenido"><i class="fa-solid fa-layer-group"></i><span>Contenido</span></a>
    <span class="nav-label">Banda</span>
    <a href="/admin/members" class="@on("miembros")" title="Miembros"><i class="fa-solid fa-user-group"></i><span>Miembros</span></a>
    <a href="/admin/shows" class="@on("shows")" title="Shows"><i class="fa-solid fa-location-dot"></i><span>Shows</span></a>
    <a href="/admin/setlists" class="@on("setlists")" title="Setlists"><i class="fa-solid fa-list-music"></i><span>Setlists</span></a>
    <a href="/admin/rehearsals" class="@on("ensayos")" title="Ensayos"><i class="fa-solid fa-drum"></i><span>Ensayos</span></a>
    <a href="/admin/news" class="@on("noticias")" title="Noticias"><i class="fa-solid fa-newspaper"></i><span>Noticias</span></a>
    <a href="/admin/tracks" class="@on("musica")" title="Música"><i class="fa-solid fa-music"></i><span>Música</span></a>
    <span class="nav-label">Sistema</span>
    <a href="/admin/users" class="@on("usuarios")" title="Usuarios"><i class="fa-solid fa-user-shield"></i><span>Usuarios</span></a>
    <a href="/admin/asistente" class="@on("asistente")" title="Asistente"><i class="fa-solid fa-ghost"></i><span>Asistente</span></a>
    <a href="/admin/files" class="@on("archivos")" title="Archivos"><i class="fa-solid fa-cloud-arrow-up"></i><span>Archivos</span></a>
  </nav>
  <div class="user">
    <span class="avatar"><i class="fa-solid fa-user"></i></span>
    <span class="username">@User.Identity?.Name</span>
    <form method="post" action="/auth/logout">@Html.AntiForgeryToken()<button class="btn btn-secondary btn-sm" type="submit" title="Salir"><i class="fa-solid fa-right-from-bracket"></i><span>Salir</span></button></form>
  </div>
</aside>
<div class="shell">
  <header class="mobilebar">
    <div class="brand">El Rey <em>del Tren Fantasma</em></div>
    <button class="hamburger" id="hamburger" aria-label="Abrir menú" aria-controls="sidebar" aria-expanded="false"><span></span></button>
  </header>
  <div class="wrap">
    @RenderBody()
  </div>
</div>
<div class="scrim" id="scrim" hidden></div>
@await Html.PartialAsync("~/Views/Admin/_AsistenteBurbuja.cshtml")
<script src="/js/asistente-burbuja.js?v=1"></script>
<script>
(function(){
  const barra = document.getElementById('sidebar'), scrim = document.getElementById('scrim'), boton = document.getElementById('hamburger');
  function menu(abrir){
    barra.classList.toggle('open', abrir);
    boton.classList.toggle('active', abrir);
    boton.setAttribute('aria-expanded', abrir);
    scrim.hidden = !abrir;
  }
  boton.addEventListener('click', ()=> menu(!barra.classList.contains('open')));
  scrim.addEventListener('click', ()=> menu(false));
  document.addEventListener('keydown', (e)=>{ if (e.key === 'Escape') menu(false); });

  const raiz = document.documentElement, alternar = document.getElementById('sideToggle');
  const sincronizar = ()=> alternar.setAttribute('aria-expanded', String(!raiz.classList.contains('admin-mini')));
  alternar.addEventListener('click', ()=>{
    const minimo = !raiz.classList.contains('admin-mini');
    raiz.classList.toggle('admin-mini', minimo);
    try { localStorage.setItem('adminSideMini', minimo ? '1' : '0'); } catch(e){}
    sincronizar();
  });
  sincronizar();
})();
</script>
</body>
</html>