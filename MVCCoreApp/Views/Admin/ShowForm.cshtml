@model MVCCoreApp.Models.Show
@{
  Layout="_AdminLayout"; var isEdit = ViewBag.IsEdit == true; ViewData["Title"]= isEdit ? "Editar show" : "Nuevo show";
  var showReh = ViewBag.ShowRehearsals as List<MVCCoreApp.Models.Rehearsal> ?? new List<MVCCoreApp.Models.Rehearsal>();
  var showSetl = ViewBag.ShowSetlistNames as Dictionary<string,string> ?? new Dictionary<string,string>();
}
<div class="welcome"><div><h2>@ViewData["Title"]</h2><p>Completa los datos del concierto. También puedes enlazar un mapa para que tus fans sepan dónde es.</p></div><a href="/admin/shows" class="btn btn-secondary btn-sm">← Volver a shows</a></div>
<form method="post" action="@(isEdit ? $"/admin/shows/edit/{Model.Id}" : "/admin/shows/create")" class="card">
  <div class="grid2">
    <div class="form-group"><label class="form-label">Fecha</label><input type="datetime-local" class="form-control" name="Date" value="@Model.Date.ToString("yyyy-MM-ddTHH:mm")" required/></div>
    <div class="form-group"><label class="form-label">Hora</label><input class="form-control" name="Time" value="@Model.Time" placeholder="21:00"/></div>
  </div>
  <div class="grid2">
    <div class="form-group"><label class="form-label">Lugar / Sala</label><input class="form-control" name="Venue" value="@Model.Venue" placeholder="Ej. Auditorio de la localidad" required/><div class="form-hint">Cómo se llama el sitio donde tocan, tal como lo leería tu público.</div></div>
    <div class="form-group"><label class="form-label">Ciudad y estado</label><input class="form-control" name="CityState" value="@Model.CityState" placeholder="Ej. Ciudad — Estado"/></div>
  </div>
  <div class="form-group"><label class="form-label">Enlace al mapa</label><input class="form-control" name="GoogleMapsUrl" value="@Model.GoogleMapsUrl" placeholder="https://maps.google.com/?q=..."/><div class="form-hint">Pega el enlace de Google Maps y tus fans podrán abrirlo con un clic.</div></div>
  <div class="form-group"><label class="form-label">Mostrar en el sitio</label><select name="IsVisible" class="form-control"><option value="true" selected="@(Model.IsVisible)">Sí, mostrar este show</option><option value="false" selected="@(!Model.IsVisible)">No, guardarlo como borrador</option></select></div>
  <input type="hidden" name="Order" value="@Model.Order"/>
  <div style="margin-top:24px;display:flex;gap:12px"><button type="submit" class="btn btn-primary"><i class="fa-solid fa-check"></i> Guardar show</button><a href="/admin/shows" class="btn btn-secondary">Cancelar</a></div>
</form>

@if(isEdit){
<div class="card">
  <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:10px;margin-bottom:12px">
    <h3 style="font:600 1.15rem/1.3 var(--font-serif)"><i class="fa-solid fa-drum" style="color:var(--accent)"></i> Ensayos del día de este show</h3>
    <a href="/admin/rehearsals/create?showId=@Model.Id" class="btn btn-primary btn-sm"><i class="fa-solid fa-plus"></i> Agendar ensayo</a>
  </div>
  @if(showReh.Any()){
    <div class="tbl-wrap">
    <table class="tbl"><thead><tr><th>Horario</th><th>Qué se va a hacer</th><th>Setlist</th><th>Lugar</th><th>Acciones</th></tr></thead><tbody>
    @foreach(var reh in showReh){
      <tr>
        <td data-label="Horario"><strong>@(reh.StartTime ?? "—") → @(reh.EndTime ?? "—")</strong></td>
        <td data-label="Qué se va a hacer">@(string.IsNullOrWhiteSpace(reh.Notes) ? "—" : reh.Notes)</td>
        <td data-label="Setlist">@(reh.SetlistId != null && showSetl.ContainsKey(reh.SetlistId) ? showSetl[reh.SetlistId] : "—")</td>
        <td data-label="Lugar">@reh.Place</td>
        <td data-label="Acciones" style="display:flex;gap:6px"><a href="/admin/rehearsals/edit/@reh.Id" class="btn btn-secondary btn-sm">Editar</a><form method="post" action="/admin/rehearsals/delete/@reh.Id" onsubmit="return confirm('¿Eliminar este ensayo?')"><button type="submit" class="btn btn-danger btn-sm">Eliminar</button></form></td>
      </tr>
    }
    </tbody></table>
    </div>
  } else {
    <p class="mono" style="margin:0">Todavía no hay ensayos planeados para este show.</p>
  }
</div>
}