@model MVCCoreApp.Models.Setlist
@{
  var esPublico = ViewData["Public"] as bool? == true;
  Layout = esPublico ? "_EnsayoLayout" : "_AdminLayout";
  ViewData["Title"] = "Ensayar: " + Model.Name;
  var shareKey = ViewBag.ShareKey as string;
  var shareHost = ViewBag.ShareHost as string;
  var shareLink = !string.IsNullOrWhiteSpace(shareKey) ? $"{shareHost}/ensayo/play/{Model.Id}?key={shareKey}" : null;
}
<div class="welcome">
  <div>
    <h2><i class="fa-solid fa-drum"></i> Ensayar: @Model.Name</h2>
    <p>Uso interno de la banda. Video oculto por defecto (144p); usa "Mostrar video" si quieres verlo. Puede mostrar anuncios.</p>
  </div>
  @if (!esPublico)
  {
    if (shareLink != null)
    {
      <button type="button" id="rp-share" class="btn btn-primary btn-sm" data-link="@shareLink"><i class="fa-solid fa-link"></i> Copiar link para compartir</button>
    }
    <a href="/admin/setlists" class="btn btn-secondary btn-sm">← Volver a setlists</a>
  }
</div>

<div class="card">
  <h3 id="rp-now">♪ Elige un tema</h3>
  <div id="rp-embed-wrap" class="rp-embed-wrap">
    <div id="rp-embed"></div>
  </div>
  <div class="input-row" style="margin-top:10px">
    <button id="rp-prev" class="btn btn-secondary btn-sm" title="Anterior (B)"><i class="fa-solid fa-backward-step"></i></button>
    <button id="rp-play" class="btn btn-primary btn-sm" title="Play/Pause (K)"><i class="fa-solid fa-play"></i> / <i class="fa-solid fa-pause"></i></button>
    <button id="rp-next" class="btn btn-secondary btn-sm" title="Siguiente (N)"><i class="fa-solid fa-forward-step"></i></button>
    <div class="rp-seek-wrap">
      <input id="rp-seek" type="range" min="0" max="1" step="0.001" value="0" title="Posición" />
      <div id="rp-marks-bar" class="rp-marks-bar"></div>
    </div>
    <span id="rp-time" class="mono">— / —</span>
    <input id="rp-vol" type="range" min="0" max="1" step="0.05" value="1" style="flex:0 1 90px" title="Volumen" />
    <button id="rp-video-toggle" class="btn btn-secondary btn-sm">Mostrar video</button>
  </div>

  <div class="rp-toolbar">
    <button id="rp-back10" class="btn btn-secondary btn-sm" title="Atrás 10s">−10s <kbd>J</kbd></button>
    <button id="rp-fwd10" class="btn btn-secondary btn-sm" title="Adelante 10s">+10s <kbd>L</kbd></button>
    <button id="rp-mark-add" class="btn btn-primary btn-sm" title="Bandera en el tiempo actual">🚩 Bandera <kbd>F</kbd></button>
    <button id="rp-loop-flags" class="btn btn-secondary btn-sm" title="Repetir entre banderas">🔁 Loop <kbd>R</kbd></button>
    <button id="rp-loop-track" class="btn btn-secondary btn-sm" title="Repetir tema">🔁 Tema</button>
    <label class="mono" for="rp-speed">Vel.</label>
    <select id="rp-speed" class="form-control" style="max-width:90px">
      <option value="0.5">0.5×</option>
      <option value="0.75">0.75×</option>
      <option value="1" selected>1×</option>
      <option value="1.25">1.25×</option>
      <option value="1.5">1.5×</option>
      <option value="2">2×</option>
    </select>
    <label class="mono" for="rp-quality">Calidad</label>
    <select id="rp-quality" class="form-control" style="max-width:90px" title="Menor calidad = menos datos">
      <option value="tiny" selected>144p</option>
      <option value="small">240p</option>
      <option value="medium">360p</option>
      <option value="large">480p</option>
      <option value="hd720">720p</option>
      <option value="auto">Auto</option>
    </select>
    <button id="rp-clear-marks" class="btn btn-secondary btn-sm" title="Borrar todas las banderas">Borrar banderas</button>
  </div>

  <ul id="rp-marks" class="rp-marks-list"></ul>
  <p id="rp-status" class="mono" style="margin-top:8px">Cargando…</p>
  <p class="form-hint">Atajos: Espacio play/pausa · K pausa · J/L ±10s · ←/→ ±5s · F bandera · R loop · N siguiente · B anterior. Video oculto por defecto.</p>
</div>

<div class="grid2" style="margin-top:14px">
  <div class="card">
    <h3>Temas del setlist</h3>
    <ol id="rp-list" style="padding-left:20px"></ol>
  </div>
  <div class="card">
    <h3>Buscar tema suelto</h3>
    <div class="input-row">
      <input id="rp-q" class="form-control" placeholder="Título + artista…" />
      <button id="rp-search-btn" class="btn btn-secondary btn-sm"><i class="fa-solid fa-magnifying-glass"></i> Buscar</button>
    </div>
    <ul id="rp-hits" style="list-style:none;padding:0;margin-top:10px"></ul>
    <p class="form-hint">Solo YouTube; el resultado se reproduce en el iframe.</p>
  </div>
</div>

<style>
.rp-item { margin:6px 0; }
.rp-item.active strong { color: var(--accent, #f97316); }
/* Embed responsivo 16:9 sin controles de YouTube: solo lo maneja la botonera propia. */
.rp-embed-wrap { position:relative; width:100%; max-width:720px; aspect-ratio:16/9; margin-top:10px; background:#000; border-radius:8px; overflow:hidden; }
.rp-embed-wrap iframe { position:absolute; inset:0; width:100% !important; height:100% !important; pointer-events:none; }
/* Modo solo audio: el iframe sigue reproduciendo, pero fuera de pantalla. */
.rp-embed-wrap.audio-only { position:fixed; left:-10000px; top:0; width:1px; height:1px; aspect-ratio:auto; margin:0; border:0; }
/* Barra con banderas pintadas encima. */
.rp-seek-wrap { position:relative; flex:2; min-width:160px; display:flex; align-items:center; }
.rp-seek-wrap input[type=range] { width:100%; }
.rp-marks-bar { position:absolute; left:8px; right:8px; top:0; bottom:0; pointer-events:none; }
/* Bandera sobre la barra. */
.rp-mark-pin { position:absolute; top:50%; transform:translate(-50%,-50%); color:var(--accent, #f97316); font-size:13px; line-height:1; pointer-events:auto; cursor:pointer; text-shadow:0 0 2px #000, 0 0 2px #000; }
.rp-mark-pin:hover::after { content:attr(data-label); position:absolute; bottom:16px; left:50%; transform:translateX(-50%); white-space:nowrap; background:#111; color:#fff; padding:2px 6px; border-radius:4px; font-size:11px; z-index:5; }
/* Herramientas bajo la barra, ancho completo. */
.rp-toolbar { display:flex; flex-wrap:wrap; align-items:center; gap:8px; width:100%; margin-top:10px; }
.rp-toolbar .btn { display:inline-flex; align-items:center; gap:4px; }
.rp-toolbar kbd { background:#1f1f1f; color:#ddd; border:1px solid #444; border-radius:4px; padding:0 4px; font-size:10px; font-family:monospace; }
.rp-marks-list { list-style:none; padding:0; margin:10px 0 0; }
</style>
<script src="/js/rehearsal-player.js?v=14"></script>
<script>
const rpShare = document.getElementById("rp-share");
if (rpShare) rpShare.onclick = async () => {
  const link = rpShare.dataset.link;
  try { await navigator.clipboard.writeText(link); }
  catch { const t=document.createElement("textarea"); t.value=link; document.body.appendChild(t); t.select(); document.execCommand("copy"); t.remove(); }
  const old = rpShare.innerHTML;
  rpShare.innerHTML = '<i class="fa-solid fa-check"></i> Link copiado';
  setTimeout(() => rpShare.innerHTML = old, 1800);
};
window.__SETLIST_ID__ = "@Model.Id";
RehearsalPlayer.init(window.__SETLIST_ID__).catch(e => {
  document.getElementById("rp-status").textContent = "Error: " + e.message;
});
</script>
